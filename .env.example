# ── OpenAI (Vocareum key — paste from Vocareum portal GenAI section) ──
OPENAI_API_KEY=your_vocareum_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-ada-002

# ── Ollama (local — already set up on your machine) ──
USE_OLLAMA=false          # set to true to use Ollama instead of OpenAI
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── RAG chunking ──
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── Storage ──
DB_PATH=data/db/eval_runs.db
CHROMA_PATH=data/db/chroma
